#!/bin/bash
# PSAM Scaling QLD — generated by make_mac_app.py. Regenerate rather than hand-editing.
#
# The project folder is normally found relative to this bundle (which lives in
# <project>/macos/). REPO_FALLBACK is stamped in at build time so a *copy* of
# the bundle — on the Desktop, in /Applications — still finds the project.

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../../../.." 2>/dev/null && pwd)"
REPO_FALLBACK="/Users/paulmontuoro/janison projects/psam annual scaling qld"

alert() {
    /usr/bin/osascript -e "display alert \"PSAM Scaling QLD\" message \"$1\" as critical" >/dev/null 2>&1
}

if [ ! -e "$REPO/psam_scaling_launcher.py" ]; then
    REPO="$REPO_FALLBACK"
fi
if [ ! -e "$REPO/psam_scaling_launcher.py" ]; then
    alert "Cannot find the project folder. Expected it at: $REPO_FALLBACK"
    exit 1
fi

cd "$REPO" || exit 1

# If this process is translated (Rosetta), re-exec natively. macOS applies
# "Open using Rosetta" per app and children inherit it, and a venv's wheels are
# typically arm64-only — so a translated python dies at `import numpy` with
# "incompatible architecture", which reads like a broken install and is not.
if [ "$(/usr/sbin/sysctl -n sysctl.proc_translated 2>/dev/null)" = "1" ]; then
    exec /usr/bin/arch -arm64 "$0" "$@"
fi

PY="$REPO/.venv/bin/python"

if [ ! -x "$PY" ]; then
    alert "No Python environment found. Expected .venv/bin/python in the project folder."
    exit 1
fi

if ! "$PY" -c "import tkinter" >/dev/null 2>&1; then
    alert "This Python has no tkinter, so the GUI cannot start. Install Python 3 from python.org, delete the virtualenv in the project folder, and launch again."
    exit 1
fi

"$PY" "$REPO/psam_scaling_launcher.py"
status=$?
# A status above 128 means the process was killed by a signal (128+signal):
# Force Quit, a `kill`, or the user logging out. That is not a crash the user
# needs an alert about, and alerting on it reads as the app having failed when
# they deliberately stopped it.
if [ $status -ne 0 ] && [ $status -lt 129 ]; then
    alert "PSAM Scaling QLD stopped with status $status. Launch it from Terminal with .venv/bin/python psam_scaling_launcher.py to see the traceback."
fi
exit $status
